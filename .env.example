# Chave de API do TMDb (The Movie Database)
# Obtenha uma chave gratuita em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# API Gateway (REST HTTP)
API_PORT=8000

# Microsserviço 1: Movie/Catalog Service (gRPC / Stateless com cache em memória)
MOVIE_SERVICE_HOST=localhost
MOVIE_SERVICE_PORT=50051

# Microsserviço 2: Review Service (gRPC / Banco de Dados Isolado de Reviews)
REVIEW_SERVICE_HOST=localhost
REVIEW_SERVICE_PORT=50052

# Microsserviço 3: User & Auth Service (gRPC / Banco de Dados Isolado de Usuários)
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=50053

# Configuração de Autenticação JWT
JWT_SECRET_KEY=criticbox_sd_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Padrão Database per Service (Bancos Isolados por Microsserviço)
# Localmente (SQLite): Se os caminhos não forem definidos, usa automaticamente:
# - data/users.db para o UserService
# - data/reviews.db para o ReviewService
USER_DATABASE_PATH=
REVIEW_DATABASE_PATH=

# Conexão MySQL / Cloud SQL (Produção GCP):
# Preencha DB_HOST para conectar ao MySQL. Cada microsserviço utilizará seu próprio schema/database:
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Nomes dos bancos de dados por serviço (padrão: criticbox_users e criticbox_reviews)
USER_DB_NAME=criticbox_users
REVIEW_DB_NAME=criticbox_reviews
