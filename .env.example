# Chave de API do TMDb (The Movie Database)
# Obtenha uma chave gratuita em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# API Gateway (REST HTTP)
API_PORT=8000

# Microsserviço 1: Movie/Catalog Service (gRPC)
MOVIE_SERVICE_HOST=localhost
MOVIE_SERVICE_PORT=50051

# Microsserviço 2: Review & User Service (gRPC)
REVIEW_SERVICE_HOST=localhost
REVIEW_SERVICE_PORT=50052

# Configuração de Autenticação JWT
JWT_SECRET_KEY=criticbox_sd_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Configurações do Banco de Dados
# Se DB_HOST for deixado em branco, a aplicação usa SQLite local (criticbox.db) automaticamente.
# Preencha para conectar ao Cloud SQL (MySQL):
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=criticbox
