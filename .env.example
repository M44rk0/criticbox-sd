# Chave de API do TMDb (The Movie Database)
# Obtenha uma chave gratuita em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# Configurações da API REST (FastAPI)
API_PORT=8000

# Configurações do Servidor gRPC
GRPC_SERVER_HOST=localhost
GRPC_SERVER_PORT=50051

# Configurações do Banco de Dados
# Se DB_HOST for deixado em branco, a aplicação usa SQLite local (criticbox.db) automaticamente.
# Preencha para conectar ao Google Cloud SQL (MySQL):
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=criticbox
